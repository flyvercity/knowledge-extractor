          "version": "repo-lines-v1:sha256:0fc57b759e44a664c11ab8049a8c76662cbc6a60ff39854af3f0e48218d5c786:"
        }
      ]
    },
    {
      "id": "claim_81f10e0785584e02b080bcae0c077cb8",
      "statement": "PDF formula detection uses heuristic analysis: it checks text spans against known math font names (symbol, cambria math, cmmi, etc.) and Unicode math character ranges, classifies spans as math if more than 30% of characters are math-like or for short spans with any math characters, groups adjacent math spans into regions within 1.5x line height and 30% page width proximity, filters regions under 10 pixels wide, and classifies formula regions as display mode when they span >70% of line width or as inline when under 30% of page width.",
      "evidence": [
        {
          "resource": "repo://src/knowledge_extractor/extractors/pdf_extractor.py#L84-L140",
          "version": "repo-lines-v1:sha256:f5e6c43ecdf3e159da07503ea59d5da26c075a84f7e7cb0bb38251d64381480a:"
