    {
      "id": "claim_5cc24b77502b4911bbe47b42248996f0",
      "statement": "The PDF extractor determines if a document is scanned by counting pages without extractable text and comparing against an 80% threshold (SCANNED_THRESHOLD), with early-exit optimization when reaching the threshold becomes mathematically impossible. Scanned PDFs are rendered page-by-page as PNG images at 200 DPI with special ![ocr] markers to route to OCR-specific pipeline prompts, while text-containing pages in scanned documents use direct text extraction.",
      "evidence": [
        {
          "resource": "repo://src/knowledge_extractor/extractors/pdf_extractor.py#L11-L35",
          "version": "repo-lines-v1:sha256:619b5c5983b8bca848ee6ce16ae71e41d9ccfb846e287e305720f4da92f0a347:"
        },
        {
